# IBM Quantum credentials for Phase 6 (scoped hardware validation).
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
#
# These are consumed by src/quantum/backends.py (IBMHardwareBackend) via
# QiskitRuntimeService — never hardcoded, never logged, never written to
# any results/ artifact.

# One of: ibm_cloud | ibm_quantum_platform
IBM_QUANTUM_CHANNEL=ibm_quantum_platform

# API token from https://quantum.cloud.ibm.com/ (Account settings)
IBM_QUANTUM_TOKEN=

# Required for the ibm_cloud channel; the CRN of your Quantum service instance.
# Leave blank if using ibm_quantum_platform and it is not required.
IBM_QUANTUM_INSTANCE=
